#!/bin/bash
# A stand-in for `claude` that lets the meet TUI be driven end to end without spending money.
#   summary writer (--json-schema): answers with the meeting's summary and write-up
#   question session (no -p, --append-system-prompt-file): echoes each typed line back.
# Every invocation is appended to $FAKE_CLAUDE_LOG so the test can assert on the args.
echo "ARGS: $*" >> "${FAKE_CLAUDE_LOG:-/dev/null}"
env | grep '^MEET_' | sort >> "${FAKE_CLAUDE_LOG:-/dev/null}"

args=("$@")
has() { for a in "${args[@]}"; do [ "$a" = "$1" ] && return 0; done; return 1; }
argval() { for ((i=0;i<${#args[@]};i++)); do [ "${args[$i]}" = "$1" ] && { echo "${args[$((i+1))]}"; return; }; done; }

# The question session (a, `meet ask`): interactive, no -p, the prompt is the last argument.
# It runs on meet's embedded terminal: print a banner, then answer each typed line until
# EOF or "exit", so the test can see keys reaching it and its output reaching the pane.
if ! has -p; then
  echo "INTERACTIVE: ${args[${#args[@]}-1]}" >> "${FAKE_CLAUDE_LOG:-/dev/null}"
  echo "fake claude · question session · $(argval --name)"
  echo "ready for questions"
  while IFS= read -r line; do
    [ "$line" = "exit" ] && { echo "bye"; exit 0; }
    echo "you asked: $line"
  done
  exit 0
fi

prompt=$(cat)
echo "PROMPT_HEAD: $(echo "$prompt" | head -c 200 | tr '\n' ' ')" >> "${FAKE_CLAUDE_LOG:-/dev/null}"

if has --json-schema; then
  # The end-of-meeting summary writer: a summary and the write-up, numbered on from the
  # previous call's. FAKE_SUGGEST_DELAY=secs holds the answer back (to see "writing…").
  n=$(grep -cF '"notes":{"type":"string"}' "${FAKE_CLAUDE_LOG:-/dev/null}" 2>/dev/null || echo 1)
  a=$((2 * n - 1)); b=$((2 * n))
  [ -n "${FAKE_SUGGEST_DELAY:-}" ] && sleep "$FAKE_SUGGEST_DELAY"
  notes="## Summary\nFake meeting $n: the speaker wants changes $a and $b shipped.\n\n## Key points\n- They talked about change $a.\n- Then about change $b.\n\n## Decisions\n- Ship changes $a and $b.\n\n## Open questions\n- Whether the README needs a title first."
  cat <<EOF
{"type":"result","subtype":"success","is_error":false,"result":"ok","structured_output":{"summary":"Meeting $n: the speaker wants changes $a and $b shipped.","notes":"$notes"},"total_cost_usd":0.05,"usage":{"input_tokens":3000,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":400}}
EOF
  exit 0
fi

echo '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"fake claude: meet makes no other headless call"}'
exit 1
